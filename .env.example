# Partners Bus Prediction — Required Environment Variables
# Copy this file to .env for local development
# Set these as Environment Variables in the Vercel dashboard for production

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite — default, no change needed):
# DATABASE_URL=sqlite:///./partners_bus.db

# Production (Neon PostgreSQL — get this from neon.tech dashboard):
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random secret for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-in-production

# ── Optional Settings ─────────────────────────────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
